{
  "name": "science-expo-2026",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamraghavan/egspogi-expo-web.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-map.mjs",
    "prebuild": "node scripts/prepare-map.mjs",
    "postinstall": "node scripts/prepare-map.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-secrets.mjs",
    "security:staged": "node scripts/check-secrets.mjs --staged",
    "security:history": "node scripts/check-secrets.mjs --history",
    "security:build": "node scripts/check-secrets.mjs --build",
    "security:test": "node --test scripts/check-secrets.test.mjs",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@supabase/supabase-js": "^2.116.0",
    "animejs": "^4.5.0",
    "clsx": "2.1.1",
    "framer-motion": "13.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.47.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
